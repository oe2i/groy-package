{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "oe2i/groy-schema",
  "description": "Opinionated Laravel 13 package for database schema definitions and migrations.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/oe2i/groy-schema",
  "keywords": [
    "oe2i",
    "groy",
    "laravel",
    "schema",
    "database",
    "migrations"
  ],
  "readme": "README.md",
  "authors": [
    {
      "name": "Anthony Osawere",
      "email": "anthony@osawere.com",
      "homepage": "https://www.osawere.com",
      "role": "Software Engineer"
    },
    {
      "name": "oe2i",
      "email": "hi@oe2i.com",
      "homepage": "https://oe2i.com",
      "role": "Organization"
    }
  ],
  "support": {
    "email": "hi@oe2i.com",
    "issues": "https://github.com/oe2i/groy-schema/issues",
    "source": "https://github.com/oe2i/groy-schema"
  },
  "prefer-stable": true,
  "minimum-stability": "stable",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/prompts": "^0.3.27"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.7",
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.15",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.3",
    "orchestra/testbench": "^11.0",
    "peckphp/peck": "^0.3.0",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-arch": "^5.0",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-evals": "^5.0",
    "pestphp/pest-plugin-faker": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-livewire": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-profanity": "^5.0",
    "pestphp/pest-plugin-rector": "^5.0",
    "pestphp/pest-plugin-stressless": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.1",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.8",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Groy\\Schema\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Groy\\Schema\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Groy\\Schema\\Providers\\SchemaServiceProvider"
      ],
      "aliases": {
        "SchemaX": "Groy\\Schema\\Facades\\Schema"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "ao:check": [
      "composer --version --ansi",
      "composer validate --strict --ansi",
      "composer check-platform-reqs --ansi",
      "composer audit --ansi",
      "composer outdated --direct --ansi"
    ],
    "ao:health": [
      "composer diagnose --ansi",
      "composer outdated --ansi",
      "composer show --tree --ansi"
    ],
    "ao:coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "./vendor/bin/pest --coverage"
    ],
    "ao:parallel": "./vendor/bin/pest --parallel",
    "ao:pest": "./vendor/bin/pest",
    "ao:tia": "./vendor/bin/pest --parallel --tia",
    "ao:pint": "./vendor/bin/pint --parallel",
    "ao:pint-check": "./vendor/bin/pint --test",
    "ao:profanity": "./vendor/bin/pest --profanity src tests",
    "ao:rector": "./vendor/bin/rector",
    "ao:rector-dry": "./vendor/bin/rector process --dry-run",
    "ao:stan": "./vendor/bin/phpstan analyse --memory-limit=2G",
    "ao:type": "./vendor/bin/pest --type-coverage --memory-limit=2G --min=90 --coverage-filter=src",
    "ao:test": [
      "@php -r \"print(PHP_EOL.'▶ Running profanity check…'.PHP_EOL);\"",
      "@ao:profanity",
      "@php -r \"print(PHP_EOL.'▶ Running type coverage...'.PHP_EOL);\"",
      "@ao:type",
      "@php -r \"print(PHP_EOL.'▶ Running tests and coverage…'.PHP_EOL);\"",
      "@ao:coverage",
      "@php -r \"print(PHP_EOL.'▶ Running pint…'.PHP_EOL);\"",
      "@ao:pint",
      "@php -r \"print(PHP_EOL.'▶ Running phpstan…'.PHP_EOL);\"",
      "@ao:stan"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "@ao:test"
    ],
    "push:spartan": [
      "@ci:check",
      "git push origin spartan"
    ],
    "release": "@php scripts/release.php",
    "post-create-project-cmd": [
      "@php scripts/configure.php"
    ]
  }
}
